# Keep this secret server-side. Never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Comma-separated free models, tried in order. Keep the :free suffix.
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,nex-agi/nex-n2.5-mini:free,google/gemma-4-31b-it:free
# Groq is the primary provider. OpenRouter is used only when Groq is unavailable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional. Used as HTTP-Referer when calling OpenRouter.
APP_URL=http://localhost:3000
